{
   "Format": "2.0.0",

   "ConfigSchema":
	{ 
		"SeasonalFoliage": 
		{ 
			"AllowValues": "true, false", 
			"Default": "false" 
		},
		"SummerFlowers": 
		{ 
			"AllowValues": "SetColour, Pink, Red, Orange, Yellow, Azure, Blue, Indigo, Purple, White", 
			"Default": "SetColour" 
		},
	},

	"DynamicTokens": 
	[
		{
			"Name": "SeasonalFoliageToken",
			"Value": "Base"
		},
		{
			"Name": "SeasonalFoliageToken",
			"Value": "{{season}}",
			"When": 
			{
				"SeasonalFoliage": "true"
			}
		}
	],

   "Changes": 
   	[
// VANILLA
		{
			"LogName": "Vanilla Obelisks",
    		"Action": "EditImage",
    		"Target": "Buildings/Desert Obelisk, Buildings/Earth Obelisk, Buildings/Water Obelisk, Buildings/Island Obelisk, Maps/Farm Obelisk",
    		"FromFile": "assets/{{SeasonalFoliageToken}}/{{TargetWithoutPath}}.png",
		},
		{
			"LogName": "Vanilla Obelisks - Summer Flowers",
    		"Action": "EditImage",
    		"Target": "Buildings/Desert Obelisk, Buildings/Earth Obelisk, Buildings/Water Obelisk, Buildings/Island Obelisk, Maps/Farm Obelisk",
    		"FromFile": "assets/SummerFlowers/{{SummerFlowers}}/{{TargetWithoutPath}}_Flowers_{{SummerFlowers}}.png",
			"PatchMode": "Overlay",
			"When": 
			{
				"SeasonalFoliage": "true",
				"SummerFlowers |contains= SetColour": false,
				"Season": "summer"
			}
		},
// DEEPWOODS
		{
			"LogName": "Deepwoods Obelisk",
    		"Action": "EditImage",
    		"Target": "Buildings/WoodsObelisk",
    		"FromFile": "assets/{{SeasonalFoliageToken}}/{{TargetWithoutPath}}.png",
			"When": 
			{
				"HasMod |contains= maxvollmer.deepwoodsmod": true
			}
		},
		{
			"LogName": "Deepwoods Obelisk",
    		"Action": "EditImage",
    		"Target": "Buildings/WoodsObelisk",
    		"FromFile": "assets/SummerFlowers/{{SummerFlowers}}/{{TargetWithoutPath}}_Flowers_{{SummerFlowers}}.png",
			"PatchMode": "Overlay",
			"When": 
			{
				"SeasonalFoliage": "true",
				"SummerFlowers |contains= SetColour": false,
				"Season": "summer",
				"HasMod |contains= maxvollmer.deepwoodsmod": true
			}
		},
// RIDGESIDE
