  "Changes": [

    //* Adds Custom Locations (Path & Farms)
    {
      "Action": "Include",
      "FromFile": "main/locations.json"
    },

    //* Patches vanilla locations (Backwoods, Railroad & Main Farms)
    {
      "Action": "Include",
      "FromFile": "main/patches_vanilla.json"
    },

    //* Patches modded locations (SVE, Coal Point Farm, Walk To The Desert)
    {
      "Action": "Include",
      "FromFile": "main/patches_mods.json"
    },

    //* Adds most warps between locations
    {
      "Action": "Include",
      "FromFile": "main/warps.json"
    },

    //* Included Buildings patches
    {
      "Action": "Include",
      "FromFile": "main/buildings.json"
    },

    //* Strings for signs or other stuff
    {
      "Action": "EditData",
      "Target": "Strings/StringsFromMaps",
      "Entries": {
        "mpf.toPathSign": "{{i18n:mpf.toPathSign}}",
        "mpf.railroadConstruction": "{{i18n:mpf.railroadConstruction}}"
      }
    },

    //* Makes cabins free
    {
      "Action": "EditData",
      "Target": "Data/Buildings",
      "TargetField": ["Cabin"],
      "Entries": {
        "BuildCost": null
      },
      "When": { "Free_Cabins": "true" }
    }
    
  ]
}
