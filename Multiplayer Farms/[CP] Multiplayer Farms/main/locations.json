{
  "Changes": [
    //* Add custom locations - Path to Farms
    {
      "Action": "Load",
      "Target": "Maps/Custom_MPF_PathToFarms",
      "FromFile": "assets/PathToFarms.tmx"
    },

    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "Custom_MPF_PathToFarms": {
          "DisplayName": "PathToFarm",
          "DefaultArrivalTile": {
            "X": 50,
            "Y": 15
          },
          "CreateOnLoad": {
            "MapPath": "Maps/Custom_MPF_PathToFarms",
            "Type": "StardewValley.GameLocation"
          }
        }
      }
    },

    //* Add custom farm - 1. Wilderness
    {
      "Action": "Load",
      "Target": "Maps/Custom_MPF_Wilderness",
      "FromFile": "assets/Farms/{{F1_FileName}}"
    },

    //? Main properties
    {
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "Custom_MPF_Wilderness": {
          "DisplayName": "{{F1_Name}}",
          "CanPlantHere": true,
          "CanHaveGreenRainSpawns": true,
          "MinDailyWeeds": 3,
          "MaxDailyWeeds": 9,
          "FirstDayWeedMultiplier": 15,
          "ChanceForClay": 0.03,
          "ExcludeFromNpcPathfinding": true,
          "Fish": [
            {
              "Chance": 0.35,
              "Id": "LOCATION_FISH Mountain BOBBER_X BOBBER_Y WATER_DEPTH",
              "ItemId": "LOCATION_FISH Mountain BOBBER_X BOBBER_Y WATER_DEPTH"
            },
            {
              "Chance": 0.35,
              "Id": "LOCATION_FISH Forest BOBBER_X BOBBER_Y WATER_DEPTH",
              "ItemId": "LOCATION_FISH Forest BOBBER_X BOBBER_Y WATER_DEPTH"
            }
          ],
          "DefaultArrivalTile": {
            "X": 48,
            "Y": 7
          },
          "CreateOnLoad": {
            "MapPath": "Maps/Custom_MPF_Wilderness",
            "Type": "StardewValley.GameLocation",
            "AlwaysActive": true
          }
        }
      },
      "When": {
        "LyzzCL.MPF_Core/FarmOne": true
      }
    },

    //? Disable intersections
    {
      "Action": "EditMap",
      "Target": "Maps/Custom_MPF_Wilderness",
