{
	"Format":"2.3",
	"ConfigSchema":{
        "EnableArrows":{
            "AllowValues":"true, false",
            "Default":"true"
        },
        "ManualRecolourSelection":{
            "AllowValues":"off, Vanilla, Earthy, Starblue, VibrantPastoral, WittilyNamed",
            "Default":"off"
        },
        "ManualInterfaceSelection":{
            "AllowValues":"off, Vanilla, Earthy, OvergrownFlowery, StarrySky, StarrySkyDark, Vintage",
            "Default":"off"
        },		              
        "StarrySkyInterfaceDarkerFont":{
            "AllowValues":"true, false",
            "Default":"false"
        },
        "VibrantPastoralFallColour":{
        	"AllowValues":"orange, green",
        	"Default":"orange"
        },
        "WittilyNamedDirtVariant":{
            "AllowValues":"dark, light",
            "Default":"dark"
        },
        "StarblueValleyBluerGrass":{
            "AllowValues":"true, false",
            "Default":"false"
        }

	},
	"DynamicTokens":[
		// recolours        
        {
            "Name": "recolour",
            "Value": "vanilla",
            "When":{
                "ManualRecolourSelection":"off, Vanilla"
            }
        },
        {
            "Name": "recolour",
            "Value": "starblue",
            "When": {
                "HasMod": "Lita.StarblueValley, Lita.StarblueValleyUnofficial",
                "ManualRecolourSelection":"off"
            }
        },
        {
            "Name": "recolour",
            "Value": "wittily",
            "When": {
                "HasMod": "Acerbicon.Recolor",
                "ManualRecolourSelection":"off"
            }
        },
        {
            "Name": "recolour",
            "Value": "earthy",
            "When": {
                "HasMod": "DaisyNiko.EarthyRecolour",
                "ManualRecolourSelection":"off"
            }
        },
        {
            "Name": "recolour",
            "Value": "vpr",
            "When": {
                "HasMod": "grapeponta.VibrantPastoralRecolor",
                "ManualRecolourSelection":"off"
            }
        },
        {
            "Name":"recolour",
            "Value":"{{ManualRecolourSelection}}",
            "When":{
                "ManualRecolourSelection |contains=off":"false"
            }
        },
        // ui mods        
        {
            "Name":"ui",
            "Value":"vanilla",
            "When":{
                "ManualInterfaceSelection":"off, Vanilla"
            }
        },
        {
            "Name":"ui",
            "Value":"OvergrownFlowery",
            "When":{
                "HasMod":"Amaryn.OvergrownFloweryInterface",
                "ManualInterfaceSelection":"off"
            }
        },
        {
            "Name":"ui",
            "Value":"Vintage",
            "When":{
                "HasMod |contains=ManaKirel.VMI, ManaKirel.VintageInterface2, Maythorn.VintageInterfaceMultipack":"true",
                "ManualInterfaceSelection":"off"
            }
        },
        {
            "Name":"ui",
            "Value":"StarrySky",
            "When":{
                "HasMod":"BeneathThePlass.StarrySkyInterfaceCP",
                "StarrySkyInterfaceDarkerFont":"false",
                "ManualInterfaceSelection":"off"
            }
        },
        {
            "Name":"ui",
            "Value":"StarrySkyDark",
            "When":{
                "HasMod":"BeneathThePlass.StarrySkyInterfaceCP",
                "StarrySkyInterfaceDarkerFont":"true",
                "ManualInterfaceSelection":"off"
            }
        },
        {
            "Name":"ui",
            "Value":"Earthy",
            "When":{
                "HasMod":"DaisyNiko.EarthyInterface",
                "ManualInterfaceSelection":"off"
            }
        },
        {
            "Name":"ui",
            "Value":"{{ManualInterfaceSelection}}",
            "When":{
                "ManualInterfaceSelection |contains=off":"false"
            }
        },
        // panorama stuff
        {
            "Name":"pan",
            "Value":"vanilla",
            "When":{"recolour":"vanilla"}
        },
        {
            "Name":"pan",
            "Value":"desaturated",
            "When":{"recolour |contains=vanilla":"false"}
        },
        {
            "Name":"seas",
            "Value":null,
            "When":{"Season":"spring,summer,fall"}
        },
        {
            "Name":"seas",
            "Value":"_snow",
            "When":{"Season":"winter"}
        },
        {
            "Name":"weath",
            "Value":null,
            "When":{"Weather":"sun,snow,wind"}
        },
        {
            "Name":"weath",
            "Value":"_rain",
            "When":{"Weather":"rain,storm"}
        },
        {
            "Name":"sunset",
            "Value":"1830",
            "When":{"Season":"spring,summer"}
        },
        {
            "Name":"sunset",
            "Value":"1730",
            "When":{"Season":"fall"}
        },
        {
            "Name":"sunset",
            "Value":"1630",
            "When":{"Season":"winter"}
        },
        {
            "Name":"nighttime",
            "Value":"2000",
            "When":{"Season":"spring,summer"}
        },
        {
            "Name":"nighttime",
            "Value":"1900",
            "When":{"Season":"fall"}
        },
        {
            "Name":"nighttime",
            "Value":"1800",
            "When":{"Season":"winter"}
        },
        // base vibrant/desaturated
        {
        	"Name":"version",
        	"Value":"vibrant",
        	"When":{"recolour":"vanilla"}
        },
        {
        	"Name":"version",
        	"Value":"desat",
        	"When":{"recolour":"earthy, wittily, vpr, starblue"}
        }
	],
	"Changes":[
		// load new seasonal tilesheets
		{
			"Action":"Load",
			"Target":"Maps/spring_daisyextras, Maps/summer_daisyextras, Maps/fall_daisyextras",
			"FromFile":"assets/base/base_{{version}}.png"
		},
		{
			"Action":"Load",
			"Target":"Maps/winter_daisyextras",
			"FromFile":"assets/base/base_{{version}}_winter.png"
		},
		// crops overlay
		{
			"Action":"EditImage",
			"Target":"Maps/spring_daisyextras, Maps/summer_daisyextras, Maps/fall_daisyextras",
			"FromFile":"assets/crops/crops_{{version}}_{{TargetWithoutPath}}.png",
			"PatchMode":"Overlay"
		},
		// recolour overlay
		{
            "Action":"EditImage",
            "Target": "Maps/spring_daisyextras, Maps/summer_daisyextras, Maps/fall_daisyextras, Maps/winter_daisyextras",
            "FromFile":"assets/recolours/{{recolour}}/{{TargetWithoutPath}}.png",
            "PatchMode":"Overlay"
        },
        // green fall patch (vpr)
        {
            "Action":"EditImage",
            "Target":"Maps/fall_daisyextras",
            "FromFile":"assets/recolours/vpr/fall_daisyextras_green.png",
            "PatchMode":"Overlay",
            "When":{
                "recolour":"vpr",
                "VibrantPastoralFallColour":"green"
            }
        },
        // light dirt patch (wittily)
        {
            "Action":"EditImage",
            "Target":"Maps/spring_daisyextras, summer_daisyextras, fall_daisyextras",
            "FromFile":"assets/recolours/wittily/{{TargetWithoutPath}}_light.png",
            "PatchMode":"Overlay",
            "When":{
                "recolour":"wittily",
                "WittilyNamedDirtVariant":"light"
            }
        },
        // bluer grass patch (starblue)
        {
            "Action":"EditImage",
            "Target":"Maps/spring_daisyextras",
            "FromFile":"assets/recolours/starblue/spring_daisyextras_bluer.png",
            "PatchMode":"Overlay",
            "When":{
                "recolour":"starblue",
                "StarblueValleyBluerGrass":"true"
            }
        },
        // cave
        {
            "Action": "Load",
            "Target": "Maps/cave_daisyextras",
            "FromFile": "assets/base/cave_daisyextras.png"
        },
        // desert
        {
            "Action":"Load",
            "Target":"Maps/desert_daisyextras",
            "FromFile":"assets/base/desert_daisyextras.png"
        },
        // panorama load
        {
            "Action":"Load",
            "Target":"Maps/panorama",
            "FromFile":"assets/panorama/{{pan}}_day.png"
        },
        // panorama edit day
        {
            "Action":"EditImage",
            "Target":"Maps/panorama",
            "FromFile":"assets/panorama/{{pan}}_day{{seas}}{{weath}}.png",
            "Update":"OnDayStart"
        },
        // panorama edit evening
        {
            "Action":"EditImage",
            "Target":"Maps/panorama",
            "FromFile":"assets/panorama/evening{{seas}}{{weath}}.png",
            "When":{"Time":"{{Range:{{sunset}},{{nighttime}}}}"},
            "Update":"OnTimeChange"
        },
        // panorama edit night
        {
            "Action":"EditImage",
            "Target":"Maps/panorama",
            "FromFile":"assets/panorama/night{{seas}}{{weath}}.png",
            "When":{"Time":"{{Range:{{nighttime}},2600}}"},
            "Update":"OnTimeChange"
        },
       // arrows       
       // down replaces _       
       {
            "Action":"EditImage",
            "Target":"LooseSprites/font_bold",
            "FromFile":"assets/arrows/{{ui}}_Down.png",
            "ToArea":{
                "X":120,
                "Y":48,
                "Width":8,
                "Height":16
            },
            "When":{
                "EnableArrows":"true"
            }
       },
       // up left replaces [
       {
            "Action":"EditImage",
            "Target":"LooseSprites/font_bold",
            "FromFile":"assets/arrows/{{ui}}_UpLeft.png",
            "ToArea":{
                "X":88,
                "Y":48,
                "Width":8,
                "Height":16
            },
            "When":{
                "EnableArrows":"true"
            }
       },
       // up right replaces ]
       {
            "Action":"EditImage",
            "Target":"LooseSprites/font_bold",
            "FromFile":"assets/arrows/{{ui}}_UpRight.png",
            "ToArea":{
                "X":104,
                "Y":48,
                "Width":8,
                "Height":16
            },
            "When":{
                "EnableArrows":"true"
            }
       },
       // down left replaces {
       {
            "Action":"EditImage",
            "Target":"LooseSprites/font_bold",
            "FromFile":"assets/arrows/{{ui}}_DownLeft.png",
            "ToArea":{
                "X":88,
                "Y":80,
                "Width":8,
                "Height":16
            },
            "When":{
                "EnableArrows":"true"
            }
       },
       // down right replaces }
       {
            "Action":"EditImage",
            "Target":"LooseSprites/font_bold",
            "FromFile":"assets/arrows/{{ui}}_DownRight.png",
            "ToArea":{
                "X":104,
                "Y":80,
                "Width":8,
                "Height":16
            },
            "When":{
                "EnableArrows":"true"
            }
       },
	]
}