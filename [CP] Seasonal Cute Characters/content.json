				"SeasonToLoad": "Summer"
			}
		},
		{
			"Name": "SeasonalClothes",
			"Value": "{{ShirtFall}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Fall"
			}
		},
		{
			"Name": "SeasonalClothes",
			"Value": "{{ShirtWinter}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Winter"
			}
		},
		// Retrieve the choosen shoes for this season/location.
		{
			"Name": "SeasonalShoes",
			"Value": "Vanilla"
		},
		{
			"Name": "SeasonalShoes",
			"Value": "{{ShoesSpring}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Spring"
			}
		},
		{
			"Name": "SeasonalShoes",
			"Value": "{{ShoesSummer}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Summer"
			}
		},
		{
			"Name": "SeasonalShoes",
			"Value": "{{ShoesFall}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Fall"
			}
		},
		{
			"Name": "SeasonalShoes",
			"Value": "{{ShoesWinter}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Winter"
			}
		}
	],
