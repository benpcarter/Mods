	"DynamicTokens": [
		// Flags used for winter appearances "Indoors" and "Outdoors" settings.
		{
			"Name": "IndoorsWinterOutfitEnabled",
			"Value": "{{WinterClothing |contains=IndoorAndOutdoor, IndoorOnly}}"
		},
		{
			"Name": "IndoorsWinterOutfitDisabled",
			"Value": "{{WinterClothing |contains=OutdoorOnly}}"
		},
		{
			"Name": "OutdoorsWinterOutfitEnabled",
			"Value": "{{WinterClothing |contains=IndoorAndOutdoor, OutdoorOnly}}"
		},
		{
			"Name": "OutdoorsWinterOutfitDisabled",
			"Value": "{{WinterClothing |contains=IndoorOnly}}"
		},
		// Used to determine the Calendar sprite to use.
		// Also used in some cases where there's a custom Portrait but no sprites and viceversa.
		{
			"Name": "CurrentSeasonAttire",
			"Value": "Spring"
		},
		{
			"Name": "CurrentSeasonAttire",
			"Value": "{{Season}}"
		},
		{
			"Name": "CurrentSeasonAttire",
			"Value": "Winter_Indoor",
			"When": {
				"Season": "Winter",
				"IndoorsWinterOutfitEnabled": true
			}
		},
		{
			"Name": "CurrentSeasonAttire",
			"Value": "Winter_Outdoor",
			"When": {
				"Season": "Winter",
				"IndoorsWinterOutfitDisabled": true
			}
		},
		// Contains the game state query used to decide whether to load the aerbics outfit.
		// Updated with custom conditions for compatibility with certain mods.
		{
			"Name": "UseAerobicsOutfit",
			"Value": false
		},
		{
			"Name": "UseAerobicsOutfit",
			"Value": "ANY \"LOCATION_NAME Target SeedShop, DAY_OF_WEEK Tuesday, WEATHER Target Sun Wind Snow\" \"IS_EVENT 58\"",
			"When": {
				"ExtraOutfitsEnabled": true
			}
		},
		{
			"Name": "UseAerobicsOutfit",
			"Value": "{{UseAerobicsOutfit}} \"IS_EVENT 3219874, LOCATION_NAME Target SeedShop\"", // Claire's 8 heart event
			"When": {
				"ExtraOutfitsEnabled": true,
				"HasMod |contains=FlashShifter.StardewValleyExpandedCP": true
			}
		},
		// Contains the game state query used to decide whether to load the spirits eve outfit.
		// Updated with custom conditions for compatibility with certain mods.
		{
			"Name": "UseSpiritsEveOutfit",
			"Value": false
		},
		{
			"Name": "UseSpiritsEveOutfit",
			"Value": "ANY \"IS_EVENT festival_fall27\"",
			"When": {
				"FestivalOutfitsEnabled": true
			}
		},
		{
			"Name": "UseSpiritsEveOutfit",
			// Can't use `LOCATION_CONTEXT Target Lemurkat_EastScarp` because EastScarp_VillageInn_SpiritEve didn't set its LocationContext=Lemurkat_EastScarp so we add every location that NPCs pass through.
			"Value": "{{UseSpiritsEveOutfit}} \"SEASON Fall, DAY_OF_MONTH 27, LOCATION_NAME Target EastScarp_Crossing EastScarp_Village EastScarp_VillageInn EastScarp_VillageInn_SpiritEve\"",
			"When": {
				"FestivalOutfitsEnabled": true,
				"HasMod |contains=Lemurkat.EastScarp": true
			}
		},
		// Used to determine in which seasons Penny should have freckles.
		// GingerIsland beach portrait will have freckles regardless of season unless PennyFreckles=Disabled.
		{
			"Name": "SeasonsToDrawPennyFreckles",
			"Value": ""
		},
		{
			"Name": "SeasonsToDrawPennyFreckles",
			"Value": "Summer",
			"When": {
				"PennyFreckles": "OnlySummer"
			}
		},
		{
			"Name": "SeasonsToDrawPennyFreckles",
			"Value": "Spring, Summer, Fall",
			"When": {
				"PennyFreckles": "NotWinter"
			}
		},
		{
			"Name": "SeasonsToDrawPennyFreckles",
			"Value": "Spring, Summer, Fall, Winter",
			"When": {
				"PennyFreckles": "AllYear"
			}
		},
		// FARMER DYNAMIC TOKENS
		// Stores the season to be used by the farmer edits.
		// Further edits can be done to add compatibility with LocationContexts from other mods.
		{
			"Name": "SeasonToLoad",
			"Value": "Spring",
			"When": {
				"SeasonalFarmerAppearance": true
			}
		},
		{
			"Name": "SeasonToLoad",
			"Value": "{{Season}}",
			"When": {
				"SeasonalFarmerAppearance": true
			}
		},
		{
			"Name": "SeasonToLoad",
			"Value": "Summer",
			"When": {
				"SeasonalFarmerAppearance": true,
				"LocalClimateOverride": true,
				"LocationContext": "Desert, Island"
			}
		},
		{
			"Name": "SeasonToLoad",
			"Value": "Summer",
			"When": {
				"SeasonalFarmerAppearance": true,
				"LocalClimateOverride": true,
				"HasMod |contains=FlashShifter.StardewValleyExpandedCP": true,
				"LocationContext": "FlashShifter.StardewValleyExpandedCP_CastleVillageOutpost"
			}
		},
		// Retrieve the choosen t-shirt for this season/location.
		{
			"Name": "SeasonalClothes",
			"Value": "Vanilla"
		},
		{
			"Name": "SeasonalClothes",
			"Value": "{{ShirtSpring}}",
			"When": {
				"SeasonalFarmerAppearance": true,
				"SeasonToLoad": "Spring"
			}
		},
		{
			"Name": "SeasonalClothes",
			"Value": "{{ShirtSummer}}",
			"When": {
