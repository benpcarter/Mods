{
	"Changes": [
		// OUTFIT LOADS
		{
			"LogName": "Load_Pam_Assets",
			"Action": "Load",
			"Priority": "High",
			"Target": "Portraits/Pam_Spring, Portraits/Pam_Summer, Portraits/Pam_Fall, Portraits/Pam_Winter_Outdoor, Portraits/Pam_Winter_Indoor, Portraits/Pam_FlowerDance, Portraits/Pam_SpiritsEve, Portraits/Pam_Aerobics, Characters/Pam_Spring, Characters/Pam_Summer, Characters/Pam_Fall, Characters/Pam_Winter_Outdoor, Characters/Pam_Winter_Indoor, Characters/Pam_FlowerDance, Characters/Pam_SpiritsEve, Characters/Pam_Aerobics",
			"FromFile": "assets/{{TargetPathOnly}}/Pam/{{TargetWithoutPath}}.png"
		},
		{
			"LogName": "Edit_Pam_Beach_Assets",
			"Action": "EditImage",
			"Target": "Portraits/Pam_Beach, Characters/Pam_Beach",
			"FromFile": "assets/{{TargetPathOnly}}/Pam/{{TargetWithoutPath}}.png",
			"When": {
				"BeachOutfitsEnabled": true
			}
		},
		// NOSE OVERLAY
		{
			"LogName": "Add_Pam_Seasonal_Nose",
			"Action": "EditImage",
			"Target": "Characters/Pam_Spring, Characters/Pam_Summer, Characters/Pam_Fall, Characters/Pam_Winter_Outdoor, Characters/Pam_Winter_Indoor, Characters/Pam_FlowerDance, Characters/Pam_Aerobics",
			"FromFile": "assets/{{TargetPathOnly}}/Pam/Pam_Nose.png",
			"PatchMode": "Overlay",
			"When": {
				"HideNoses": false
			}
		},
		{
			"LogName": "Add_Pam_Beach_Nose",
			"Action": "EditImage",
			"Target": "Characters/Pam_Beach",
			"FromFile": "assets/{{TargetPathOnly}}/Pam/{{TargetWithoutPath}}_Nose.png",
			"PatchMode": "Overlay",
			"When": {
				"HideNoses": false,
				"BeachOutfitsEnabled": true
			}
		},
		{
			"LogName": "Add_Pam_SpiritsEve_Nose",
			"Action": "EditImage",
			"Target": "Characters/Pam_SpiritsEve",
			"FromFile": "assets/{{TargetPathOnly}}/Pam/{{TargetWithoutPath}}_Nose.png",
			"PatchMode": "Overlay",
			"When": {
				"HideNoses": false
			}
		},
		// APPEARANCE DATA
		{
			"LogName": "Add_Pam_Appearances",
			"Action": "EditData",
			"Target": "Data/Characters",
			"TargetField": [
				"Pam",
				"Appearance"
			],
			"Entries": {
				// Seasonal Outfits
				"{{ModId}}.PamSpring": {
					"Id": "{{ModId}}.PamSpring",
					"Portrait": "Portraits/Pam_Spring",
					"Sprite": "Characters/Pam_Spring",
					"Season": "spring"
				},
				"{{ModId}}.PamSummer": {
					"Id": "{{ModId}}.PamSummer",
					"Portrait": "Portraits/Pam_Summer",
					"Sprite": "Characters/Pam_Summer",
					"Season": "summer"
				},
				"{{ModId}}.PamFall": {
					"Id": "{{ModId}}.PamFall",
					"Portrait": "Portraits/Pam_Fall",
					"Sprite": "Characters/Pam_Fall",
					"Season": "fall"
				},
				"{{ModId}}.PamWinterIndoor": {
					"Id": "{{ModId}}.PamWinterIndoor",
					"Portrait": "Portraits/Pam_Winter_Indoor",
					"Sprite": "Characters/Pam_Winter_Indoor",
					"Season": "winter",
					"Indoors": "{{IndoorsWinterOutfitEnabled}}",
					"Outdoors": "{{OutdoorsWinterOutfitDisabled}}",
					"Precedence": -101
				},
				"{{ModId}}.PamWinterOutdoor": {
					"Id": "{{ModId}}.PamWinterOutdoor",
					"Portrait": "Portraits/Pam_Winter_Outdoor",
					"Sprite": "Characters/Pam_Winter_Outdoor",
					"Season": "winter",
					"Indoors": "{{IndoorsWinterOutfitDisabled}}",
					"Outdoors": "{{OutdoorsWinterOutfitEnabled}}",
					"Precedence": -101
				},
				// Extra Outfits
				"{{ModId}}.PamAerobics": {
					"Id": "{{ModId}}.PamAerobics",
					"Portrait": "Portraits/Pam_Aerobics",
					"Sprite": "Characters/Pam_Aerobics",
					"Condition": "{{ExtraOutfitsEnabled}}, IS_EVENT 58",
					"Precedence": -200
				},
				// Festival Outfits
				"{{ModId}}.PamFlowerDance": {
					"Id": "{{ModId}}.PamFlowerDance",
					"Portrait": "Portraits/Pam_FlowerDance",
					"Sprite": "Characters/Pam_FlowerDance",
					"Condition": "IS_EVENT festival_spring24, {{FestivalOutfitsEnabled}}",
					"Precedence": -300
				},
				"{{ModId}}.PamSpirit": {
					"Id": "{{ModId}}.PamSpirit",
					"Portrait": "Portraits/Pam_SpiritsEve",
					"Sprite": "Characters/Pam_SpiritsEve",
					"Condition": "{{UseSpiritsEveOutfit}}",
					"Precedence": -300
				}
			}
		},
		// CALENDAR
		{
			"LogName": "Edit_Pam_Calendar_Sprite",
			"Action": "EditImage",
			"Target": "Characters/Pam",
			"FromFile": "assets/{{Target}}/Pam_{{CurrentSeasonAttire}}.png"
		},
		{
			"LogName": "Add_Pam_Calendar_Nose",
			"Action": "EditImage",
			"Target": "Characters/Pam",
			"FromFile": "assets/{{Target}}/Pam_Nose.png",
			"PatchMode": "Overlay",
			"When": {
				"HideNoses": false
			}
		},
		// MISCELLANEOUS
		{
			"LogName": "Pam_Bus",
			"Action": "EditImage",
			"Target": "LooseSprites/Cursors",
			"FromFile": "assets/Other/HideNoses/{{HideNoses}}/{{Target}}_{{Season}}.png",
			"FromArea": { "X": 383, "Y": 1311, "Width": 15, "Height": 19 },
			"ToArea": { "X": 383, "Y": 1311, "Width": 15, "Height": 19 }
		}
	]
}