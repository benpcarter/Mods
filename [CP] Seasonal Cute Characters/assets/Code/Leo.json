					"Precedence": -300
				},
				"{{ModId}}.LeoSpirit": {
					"Id": "{{ModId}}.LeoSpirit",
					"Portrait": "Portraits/Leo_SpiritsEve",
					"Sprite": "Characters/Leo_SpiritsEve",
					"Condition": "{{UseSpiritsEveOutfit}}",
					"Precedence": -300
				}
			}
		},
		// CALENDAR
		{
			"LogName": "Edit_Leo_Calendar_Sprite",
			"Action": "EditImage",
			"Target": "Characters/ParrotBoy",
			"FromFile": "assets/{{TargetPathOnly}}/Leo/Leo_{{Season}}.png"
		},
		{
			"LogName": "Add_Leo_Calendar_Nose",
			"Action": "EditImage",
			"Target": "Characters/ParrotBoy",
			"FromFile": "assets/{{TargetPathOnly}}/Leo/Leo_Nose.png",
