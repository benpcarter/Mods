      "Target": "Characters/DwarfBFS",
      "FromFile": "Assets/EtayBody.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Portraits/DwarfBFS",
      "FromFile": "Assets/EtayFace.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Characters/DwarfCFS",
      "FromFile": "Assets/UnemuBody.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Portraits/DwarfCFS",
      "FromFile": "Assets/UnemuFace.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Characters/DwarfDFS",
      "FromFile": "Assets/DinnBody.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Portraits/DwarfDFS",
      "FromFile": "Assets/DinnFace.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Characters/DwarfEFS",
      "FromFile": "Assets/DinnuthnolBody.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    },
    {
      "Action": "EditImage",
      "Target": "Portraits/DwarfEFS",
      "FromFile": "Assets/DinnuthnolFace.png",
      "When": {
        "HasMod |contains=Lizzie.Stoffton": true
      }
    }
  ]
}