            "AllowValues": "true, false",
            "Default": "true",
            "Description": "Allows forest forage to spawn in Farm."
        },
		 "Spawn Ore": {
            "AllowValues": "true, false",
            "Default": "true",
            "Description": "Allows quarry ore nodes to spawn in Farm quarry area."
        },
		 "Spawn Stumps": {
            "AllowValues": "true, false",
            "Default": "true",
            "Description": "Allows 6 hardwood stumps to spawn in the bottom left corner of the Farm Map."
        },
		 "Grass Tiles Marks for Trees": {
            "AllowValues": "true, false",
            "Default": "false",
            "Description": "Adds dark grass patches in top left corner for easier fruit trees placement."
        },
	
